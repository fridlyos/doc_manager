# doc_manager deployment configuration — SAFE PLACEHOLDERS ONLY.
# Copy to .env and adjust. Never commit a real .env, secrets, or the OpenAI key.
# The OpenAI key is NOT set here; it is mounted as a Docker secret (see
# compose.external-llm.yaml).

# --- Runtime / environment ---
DOCMAN_ENV=development
DOCMAN_LOG_LEVEL=INFO

# --- Host port for the API (bound to 127.0.0.1 by compose) ---
DOCMAN_HOST_PORT=8000

# --- Application binding (inside the container compose overrides host/port) ---
DOCMAN_BIND_HOST=127.0.0.1
DOCMAN_PORT=8000

# --- PostgreSQL (compose builds DOCMAN_DATABASE_URL from these) ---
DOCMAN_POSTGRES_USER=docman
DOCMAN_POSTGRES_PASSWORD=change-me-locally
DOCMAN_POSTGRES_DB=docman
DOCMAN_DATABASE_URL=postgresql+psycopg://docman:change-me-locally@postgres:5432/docman

# --- Qdrant ---
DOCMAN_QDRANT_URL=http://qdrant:6333
DOCMAN_QDRANT_COLLECTION=doc_chunks

# --- Generation providers ---
# local Ollama by default; no external egress.
DOCMAN_GENERATION_PROVIDER=ollama
DOCMAN_EXTERNAL_LLM_ENABLED=false
DOCMAN_EXTERNAL_PROVIDER_ALLOWLIST=openai
DOCMAN_EXTERNAL_SOURCE_DEFAULT=deny
DOCMAN_EXTERNAL_MAX_EVIDENCE_TOKENS=12000
DOCMAN_EXTERNAL_MAX_OUTPUT_TOKENS=2000
DOCMAN_EXTERNAL_REQUEST_TIMEOUT_SECONDS=90

# Native Windows Ollama, reached from containers via host.docker.internal.
DOCMAN_OLLAMA_URL=http://host.docker.internal:11434
DOCMAN_OLLAMA_CHAT_MODEL=llama3.1:8b

# OpenAI (only when external generation is enabled). Model id is required then.
# DOCMAN_OPENAI_MODEL=
# The key file path INSIDE the api container (Docker secret mount target):
DOCMAN_OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# The key file path ON THE WINDOWS HOST (ACL-protected, outside the repo):
# DOCMAN_OPENAI_API_KEY_HOST_FILE=C:/secrets/docman-openai.key

# --- Embeddings + artifacts ---
DOCMAN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCMAN_ARTIFACT_ROOT=/app-data/extracted-text
DOCMAN_ALLOWED_SOURCE_ROOTS=/sources

# --- Source / NAS mounts (Windows uses forward slashes, e.g. Z:/Documents) ---
# Default points at the in-repo synthetic corpus so `make up` works with no NAS.
DOCMAN_NAS_DOCUMENTS_HOST_PATH=./test-data/synthetic/source-roots
# DOCMAN_NAS_ARTIFACTS_HOST_PATH=Z:/DocManager/artifacts
DOCMAN_NAS_BACKUPS_HOST_PATH=./.backups
DOCMAN_NAS_MOUNT_SENTINEL=.docman-source-id

# --- Backup retention ---
DOCMAN_BACKUP_ROOT=/backups
DOCMAN_BACKUP_RETENTION_DAILY=14
DOCMAN_BACKUP_RETENTION_WEEKLY=8
DOCMAN_BACKUP_RETENTION_MONTHLY=12

# --- Worker / jobs ---
DOCMAN_WORKER_CONCURRENCY=1
DOCMAN_JOB_LEASE_SECONDS=300

# --- Chunking / search ---
DOCMAN_CHUNK_TARGET_TOKENS=750
DOCMAN_CHUNK_OVERLAP_TOKENS=100
DOCMAN_SEARCH_TOP_K=12
# DOCMAN_SEARCH_SCORE_THRESHOLD=
DOCMAN_STORE_QUERY_HISTORY=false
